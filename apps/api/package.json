{
  "name": "api",
  "version": "0.1.0",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node-dev --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "catalog:import": "ts-node --transpile-only src/scripts/import-games.ts",
    "catalog:popularity": "ts-node --transpile-only src/scripts/refresh-popularity.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "~10.1.6",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^6.1.2",
    "@sinclair/typebox": "^0.32.15",
    "@vefacaglar/db": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.0",
    "jose": "^5.10.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typesense": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
