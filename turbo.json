{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "WEB_URL",
        "DATABASE_URL",
        "PG_POOL_MAX",
        "API_PORT",
        "IMAGEKIT_PUBLIC_KEY",
        "IMAGEKIT_PRIVATE_KEY",
        "IMAGEKIT_FOLDER",
        "IMAGEKIT_URL_ENDPOINT",
        "TYPESENSE_HOST",
        "TYPESENSE_PORT",
        "TYPESENSE_PROTOCOL",
        "TYPESENSE_API_KEY",
        "TYPESENSE_PUBLIC_URL",
        "TYPESENSE_LANGUAGES",
        "REDIS_URL"
      ],
      "outputs": [
        ".next/**",
        "!next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
