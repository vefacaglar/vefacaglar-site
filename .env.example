# apps/api
API_PORT=3001
API_URL=http://localhost:3001
# API base URL for Swagger docs. Production example: https://api.vefacaglar.com
API_URL=http://localhost:3001

# packages/db
DATABASE_URL=postgresql://user:password@localhost:5432/vefa_site

# apps/web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ImageKit Configuration (Backend uploads)
IMAGEKIT_PUBLIC_KEY=your_public_api_key
IMAGEKIT_PRIVATE_KEY=your_private_api_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id/
IMAGEKIT_FOLDER=/uploads

# Typesense (used for dashboard list search across games-related entities)
TYPESENSE_HOST=your-typesense-host.example.com
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=your_typesense_api_key

# Comma-separated list of languages to index. First entry is the base language
# (its content is taken directly from the DB; other languages read from the
# `localizations` table). Default: "en". Example: TYPESENSE_LANGUAGES=en,tr
TYPESENSE_LANGUAGES=en

# Redis (used to share Typesense health state across Vercel serverless invocations)
REDIS_URL=redis://default:password@your-redis-host.example.com:6379