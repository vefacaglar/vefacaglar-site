# Add these as individual GitHub Actions secrets, or use the optional API_ENV secret.
# Preserve the existing production values; no database migration is run by CD.
DATABASE_URL=postgresql://user:password@postgres:5432/vefacaglar
PG_POOL_MAX=10
API_URL=https://api2.vefacaglar.com
WEB_URL=https://vefacaglar.com,https://www.vefacaglar.com
AUTH_MODE=oidc
OIDC_ISSUER=https://auth.vefacaglar.com
OIDC_CLIENT_ID=replace-with-existing-client-id
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
# Copy the current API's ImageKit, Redis, Typesense and OIDC settings as needed.
# Preserve the current Typesense API key and language list.
# Live job stream: HS256 key for 120 s job-scoped stream tokens (random, >= 32 bytes;
# unset = random per-process key, fine for a single instance). Origins allowed to open
# the SSE stream directly (default: https://vefacaglar.com,https://www.vefacaglar.com).
JOB_STREAM_TOKEN_SECRET=
WEB_ORIGINS=https://vefacaglar.com,https://www.vefacaglar.com
