# Generated by CD from GitHub secrets (see README.md); shown here for reference.
# Raw NAME=value lines: no quotes, no shell expansion.
DATABASE_URL=postgresql://user:password@postgres:5432/vefacaglar
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=replace-with-the-admin-api-key
# Required for catalog.popularity.refresh; search-only workers do not use these.
IGDB_CLIENT_ID=replace-with-the-igdb-client-id
IGDB_CLIENT_SECRET=replace-with-the-igdb-client-secret
# Optional application logs (see docs/application-logs.md).
# LOG_TYPESENSE_URL=http://typesense:8108
# LOG_TYPESENSE_API_KEY=
# Optional
RUST_LOG=info
# Managed Compose uses automatic, unique IDs for its two replicas.
# Deployment also owns WORKER_CONTROL_FILE and WORKER_CONTROL_STATUS_FILE.
# Do not override admission controls; local development without them is active.
# Set WORKER_ID only for a separately managed worker with its own unique ID.
# WORKER_DB_POOL_MAX=5
